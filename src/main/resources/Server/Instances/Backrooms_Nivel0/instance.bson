{
  "Version": 4,
  "RequiredPlugins": {
    "Hytale:EntityModule": "*",
    "Hytale:NPC": "*"
  },
  "GameMode": "Adventure",
  "WorldGen": {
    "Type": "Void",
    "Environment": "Default"
  },
  "ChunkStorage": {
    "Type": "Hytale"
  },
  "SpawnProvider": {
    "Id": "Global",
    "SpawnPoint": {
      "X": 0.5,
      "Y": 80.0,
      "Z": 0.5,
      "Pitch": 0.0,
      "Yaw": 180.0,
      "Roll": 0.0
    }
  },
  "IsSpawningNPC": true,
  "IsTicking": true,
  "IsSavingPlayers": false,
  "DeleteOnRemove": true,
  "Plugin": {
    "Instance": {
      "RemovalConditions": [
        {
          "Type": "WorldEmpty",
          "TimeoutSeconds": 10
        }
      ]
    }
  }
}