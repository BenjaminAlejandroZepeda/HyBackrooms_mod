{
  "Version": 4,
  "RequiredPlugins": {
    "Hytale:EntityModule": "*",
    "Hytale:NPC": "*"
  },
  "WorldGen": {
    "Type": "HytaleGenerator",
    "WorldStructure": "Default_Flat"
  },
